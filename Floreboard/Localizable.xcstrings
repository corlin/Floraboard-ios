    "design.pro.image.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI will deeply analyze structure, scale, and mood to generate a professional plan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA analysera la structure, la taille et l'ambiance pour générer un plan professionnel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI が画像の構造、サイズ、雰囲気を深く分析し、プロフェッショナルな花芸プランを生成します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 이미지의 구조, 크기, 분위기를 심층 분석하여 전문가 수준의 꽃꽂이 플랜을 생성합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 将深度分析图片的结构、尺寸、氛围，生成专业花艺方案"
          }
        }
      }
    },
